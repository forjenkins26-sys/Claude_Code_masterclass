# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required: query rewriting and answer generation both call Groq.
GROQ_API_KEY=
# llama-3.3-70b-versatile was decommissioned and 404s.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3

# Qdrant. Leave QDRANT_URL empty to run embedded (a local folder, no Docker).
# Set it to e.g. http://localhost:6333 to use a real server instead.
QDRANT_URL=
COLLECTION=vwo_test_cases

# Chunking. 1400 keeps every row of the bundled 5,000-row corpus whole
# (longest assembled document measured at 1239 chars).
CHUNK_SIZE=1400
CHUNK_OVERLAP=150

# Rerank backend: fast (MiniLM/ONNX, ~1.9s) or bge (568M cross-encoder, ~43s).
RERANK_BACKEND=fast

# Retrieval
TOP_N_HYBRID=20
TOP_K_RERANK=4
RRF_K=60
REWRITE_ENABLED=1
REWRITE_COUNT=3

# Models. EMBED_BACKEND=fast (fastembed/ONNX, 384-dim, ~13 min for 5,000 rows
# on CPU) or bge-m3 (PyTorch, 1024-dim, ~5 hours on the same CPU).
# Switching backends changes the vector width, so re-ingest with
# 'Recreate collection' ticked.
EMBED_BACKEND=fast
# fp16 is a GPU feature; on CPU it is emulated and runs slower.
BGE_USE_FP16=0
# Cross-encoder rerank costs seconds per chat query on CPU. Set 0 to skip.
RERANK_ENABLED=1
# 32 is fine with 8 cores and ~8 GB free. On a small hosted instance a
# batch of 32 allocates a ~290 MB ONNX arena and OOMs a 512 MB box; the
# app falls back to 4 there automatically when this is unset.
INGEST_BATCH=32

# Server
HOST=127.0.0.1
PORT=5050
MAX_UPLOAD_MB=64

# Silences a Windows-only huggingface_hub warning about symlink support.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
